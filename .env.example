# Copy this file to .env for local development.
# Never commit .env or real credentials.

FLASK_CONFIG=development
FLASK_DEBUG=true
SECRET_KEY=replace-with-a-long-random-local-secret
DATABASE_URL=sqlite:///internshield.sqlite3
HOST=127.0.0.1
PORT=5000

# Upload and analysis limits
MAX_CONTENT_LENGTH=5242880
MAX_ANALYSIS_CHARACTERS=50000

# Optional AI layer. The application remains functional when disabled.
# Enable only after configuring an OpenAI-compatible endpoint and reviewing its data policy.
# AI_BASE_URL example: https://openrouter.ai/api/v1
# AI_MODEL must be a model identifier supported by your provider.
AI_ENABLED=false
AI_PROVIDER=openai-compatible
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# Set true only when serving the application over HTTPS.
SESSION_COOKIE_SECURE=false
